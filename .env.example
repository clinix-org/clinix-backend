# Configurações da aplicação Clinix API — copie para .env.local
SPRING_PROFILES_ACTIVE=local
PORT=8090

# --- Banco de dados ---
# Opção 1: H2 em memória (padrão, sem instalação necessária)
DB_URL=jdbc:h2:mem:clinix_db
DB_USERNAME=sa
DB_PASSWORD=
DB_DDL_AUTO=create-drop

# Opção 2: PostgreSQL via Docker — comente o bloco H2 acima e descomente abaixo
# DB_URL=jdbc:postgresql://clinix-saude-postgres:5432/clinix_db
# DB_USERNAME=clinix_user
# DB_PASSWORD=clinix_password
# DB_DDL_AUTO=update
# Se a porta 5432 já estiver em uso, descomente e suba com:
# docker compose --env-file .env.local --profile local-db up -d --build
# POSTGRES_PORT=5433

# Opção 3: PostgreSQL gerenciado (Neon DB / Cloud)
# DB_URL=jdbc:postgresql://ep-cool-name-123456.us-east-2.aws.neon.tech/clinix?sslmode=require
# DB_USERNAME=seu_usuario_neon
# DB_PASSWORD=sua_senha_neon
# DB_DDL_AUTO=update

# --- Segurança (JWT) ---
JWT_SECRET=minhaChaveSecretaSuperSeguraParaDev123456789
JWT_EXPIRATION_MS=3600000

# --- Integração e ferramentas ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8091
JPA_SHOW_SQL=true
SWAGGER_ENABLED=true

# --- Administrador inicial (bootstrap) ---
BOOTSTRAP_ADMIN_ENABLED=true
ADMIN_EMAIL=admin.demo@clinix.com
ADMIN_PASSWORD=123456
ADMIN_NAME=Administrador
ADMIN_ACTIVE=true